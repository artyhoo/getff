#!/usr/bin/env bash
# Pre-commit hook: fast checks only (target: <5 seconds).
# Author-side enforcement for rules-as-tests-aif repo.
# Installs via: make install-hooks
#
# Probes (Decision matrix MUST rows, self-application.md §3):
#   - Bash syntax:      bash -n on changed *.sh
#   - JSON validity:    python3 json.load on changed *.json
#   - YAML validity:    python3 yaml.safe_load on changed *.yml/*.yaml
#   - Markdown ≤500 lines: awk on changed *.md
#   - markdownlint-cli2:   structural rules on staged *.md (sub-wave 7.1.a)
#   - guard-liveness:  ESLint rules in rules-manifest.json have negative-test.input

# ── husky-own-worktree-delegate (begin) ─────────────────────────────────────
# Run THIS worktree's copy of the hook, whatever core.hooksPath points at. The Claude desktop
# app writes an absolute `core.hooksPath=<primary>/.husky` into every worktree it opens, so git
# runs the primary checkout's files — 457 commits stale on 2026-09-30, which let a pre-commit
# check miss in a worktree and land in CI (#1983). POSIX sh, so the one block also serves
# post-checkout, which runs under sh.
# Must stay above any other code; packages/core/hooks/husky-self-delegate.test.ts gates that.
__own_hook="$(git rev-parse --show-toplevel 2>/dev/null)/.husky/${0##*/}"
if [ -x "$__own_hook" ] \
  && [ "$(cd "$(dirname "$__own_hook")" && pwd -P)" != "$(cd "$(dirname "$0")" && pwd -P)" ]; then
  exec "$__own_hook" "$@"
fi
unset __own_hook
# ── husky-own-worktree-delegate (end) ───────────────────────────────────────

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
CHANGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$CHANGED" ] && ! git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then  # a merge commit may stage nothing new; the unpushed-merge arm at the end still runs
  exit 0
fi

fail=0

while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in
    *.sh)
      if ! bash -n "$f" 2>/tmp/pre-commit-err; then
        echo "❌ Bash syntax error in $f:"
        cat /tmp/pre-commit-err
        fail=1
      fi
      ;;
    *.json)
      if ! python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f" 2>/tmp/pre-commit-err; then
        echo "❌ Invalid JSON in $f:"
        cat /tmp/pre-commit-err
        fail=1
      fi
      ;;
    *.yml|*.yaml)
      if ! python3 -c "import yaml,sys; yaml.safe_load(open(sys.argv[1]))" "$f" 2>/tmp/pre-commit-err; then
        echo "❌ Invalid YAML in $f:"
        cat /tmp/pre-commit-err
        fail=1
      fi
      ;;
    *.md)
      # Exempt: declared-transient artifacts (must contain "transient artifact" in first 20 lines)
      # (2026-08-08: no CI mirror — audit-self.yml carries no 600-line check; this hook is the only channel.)
      case "$f" in
        docs/meta-factory/EXECUTION-PLAN.md)
          if grep -qi "transient artifact" <<<"$(head -20 "$f")"; then
            : # skip — declared transient, see line 8
          else
            echo "❌ $f is in exempt list but lacks 'transient artifact' marker in first 20 lines"
            fail=1
          fi
          continue
          ;;
        # Grandfathered over-limit closed research-patch (605 lines at closure, 2026-05-29).
        # Append-only archive: splitting would sever its folder-level authority + external
        # citations, so it is exempted instead (operator decision 2026-08-08, PR #1282 fork).
        # The marker requirement keeps the exemption self-documenting at the file itself.
        docs/meta-factory/research-patches/2026-05-29-aif-handoff-bridge-variant-b-prime-hybrid.md)
          if grep -qi "line-limit-exempt" <<<"$(head -20 "$f")"; then
            : # skip — grandfathered, see marker in file header
          else
            echo "❌ $f is in exempt list but lacks 'line-limit-exempt' marker in first 20 lines"
            fail=1
          fi
          continue
          ;;
        # Oversized closed meta-kickoffs (730/664 lines at the 2026-08-21 host-verify
        # retrofit). Both had ALREADY self-declared the 'transient artifact' exemption in
        # their headers (SSOT #116 note, line 3) — only this case entry was missing, so the
        # gate would have blocked the first-ever edit since it landed. Append-only history:
        # same list∩marker shape as the two entries above.
        .claude/orchestrator-prompts/queue-mode-bootstrap/kickoff.md|\
.claude/orchestrator-prompts/strategic-clarity-dialogue/kickoff.md)
          if grep -qi "transient artifact" <<<"$(head -20 "$f")"; then
            : # skip — declared transient in file header (pre-existing)
          else
            echo "❌ $f is in exempt list but lacks 'transient artifact' marker in first 20 lines"
            fail=1
          fi
          continue
          ;;
      esac
      lines=$(awk 'END{print NR}' "$f")
      if [ "$lines" -gt 600 ]; then
        echo "❌ Markdown file $f exceeds 600 lines ($lines lines). Split or trim."
        fail=1
      fi
      ;;
  esac
done <<< "$CHANGED"

# ── markdownlint-cli2 on staged *.md (structural rules) ─────────────────────
#   Runs after the per-file loop so line-count failures are already recorded.
#   Uses ACMR diff-filter (includes renames) to catch moved docs with violations.
#   History: the orchestrator-prompts corpus was briefly excluded on legacy
#   touches (2026-08-21 host-verify retrofit, A/M split) with a re-entry
#   trigger; the trigger FIRED the same day (PR: legacy lint+link repair —
#   401 violations repaired to zero across 956 on-disk md files) and the filter was
#   dropped. The whole corpus lints again.
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '\.md$' || true)
if [ -n "$STAGED_MD" ]; then
  if command -v npx &>/dev/null; then
    # shellcheck disable=SC2086
    npx markdownlint-cli2 $STAGED_MD \
      || { echo "❌ markdownlint-cli2 violations — fix before commit"; fail=1; }
  fi
fi

# ── `path:line` blank landing — ARM 2 at its earliest reachable channel ─────
# spec: scripts/check-line-citations.mjs header («Channels follow from that split»),
#       packages/core/hooks/pre-push.ts §9.
#
# The checker has two arms with different earliest channels. ARM 1 (has the cited line
# changed since the citing sentence was written) blames the citing line, so it needs a
# committed baseline and cannot run before pre-push. ARM 2 (the cited line is blank)
# reads only the working tree, so it is the arm that can refuse a citation WRONG AT
# BIRTH — the shape of the originating incident (`arch/SKILL.md:94`, an empty line), cite:historical line number at incident time
# and the shape ARM 1 is green on by construction, because its blame commit IS the
# birth commit. Both arms ran only at pre-push until 2026-09-14, one rung late for this
# one. Pre-push §9 keeps running BOTH: husky is absent for aif-container commits and
# `git commit --no-verify` skips this file entirely, so the later channel stays the
# backstop rather than becoming a duplicate.
#
# SCOPE is the checker's own corpus definition, asked for with `--in-corpus`: every
# staged path goes in and the checker keeps the corpus members — live-authority Markdown
# (retros, research-patches and specs cite a line as a dated snapshot, and renumbering
# those rewrites history) plus code comments, since 2026-09-22. Until then this block
# kept `CITE_SCOPE`, a hand copy of the Markdown list with a parity arm diffing the two;
# the code half excludes generated twins, kickoff material and fixture data by rules no
# flat list here could express, so the copy was retired rather than extended.
#
# Two declared limits, measured 2026-09-14 rather than assumed, both backstopped by §9:
#   · The checker reads the WORKING TREE, not the index — as does every other section of
#     this file. Stage a citation onto a blank line, then fix the target on disk without
#     staging it, and this gate passes while the INDEX still carries the defect. So the
#     claim is «wrong at birth, as it stands on disk», not «cannot enter history».
#   · A rename-ONLY commit never reaches this block at all: `CHANGED` above is built with
#     `--diff-filter=ACM`, which is empty for a pure rename, and the hook exits 0 at that
#     guard before any section runs (unless MERGE_HEAD exists). A rename that MOVES a doc can break a relative
#     citation, so this is real — it is simply not this block's to fix.
# An array, not a word-split string: a staged path with a space would otherwise reach the
# checker as two fragments, which --in-corpus drops, and the file would go unchecked.
CITE_FILES=()
while IFS= read -r f; do
  # `-f`: a path staged and then deleted from the working tree makes the checker throw
  # ENOENT, which the `||` below would report as a blank-landing verdict — a red naming
  # the wrong defect. Same guard as the per-file loop at the top of this file.
  [ -f "$f" ] && CITE_FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
#
# Guarded on `command -v node` rather than failing hard, for one reason and not the
# usual one: letting a missing interpreter fall through the `||` below would print a
# blank-landing verdict for a machine that has no node, which is an unactionable red.
# The skip costs no coverage — pre-push §9 runs ARM 2 again, and the sections around it
# die loudly without node, so nothing reaches origin unchecked.
if [ "${#CITE_FILES[@]}" -gt 0 ] && command -v node &>/dev/null; then
  cite_rc=0
  node "$REPO_ROOT/scripts/check-line-citations.mjs" --check --blank-only --in-corpus "${CITE_FILES[@]}" \
    || cite_rc=$?
  if [ "$cite_rc" -eq 1 ]; then
    echo "❌ blank-landing \`path:line\` citation(s) — the cited line is empty; fix the number, or drop the citation"; fail=1
  elif [ "$cite_rc" -ne 0 ]; then
    echo "❌ check-line-citations could not run (exit $cite_rc) — see its message above"; fail=1
  fi
fi

# ── pipe into an early-exiting grep under pipefail (SIGPIPE race) ──────────
# spec: header of scripts/check-pipefail-early-exit.mjs; incident: setup.d/99-finalize.sh
#       _r2_boundary_under returned 141 in 1/400 runs under load (2026-09-29).
# Change-scoped: the checker keeps only staged paths in its population (installer, setup.d +
# the companions.manifest detect_cmd column, audit-self, hooks, skill helpers, .husky, scripts,
# tests/install-sh), so a commit that touches none of them costs one node start. The CI step
# «pipefail early-exit gate» scans the whole population — the backstop for `--no-verify` and for
# aif-container commits, where husky is absent.
if command -v node &>/dev/null; then
  PF_FILES=()
  while IFS= read -r f; do [ -n "$f" ] && [ -f "$f" ] && PF_FILES+=("$f"); done <<<"$CHANGED"
  if [ "${#PF_FILES[@]}" -gt 0 ]; then
    pf_rc=0
    node "$REPO_ROOT/scripts/check-pipefail-early-exit.mjs" "${PF_FILES[@]}" >/tmp/pre-commit-pf 2>&1 || pf_rc=$?
    if [ "$pf_rc" -ne 0 ]; then
      cat /tmp/pre-commit-pf
      echo "❌ pipe into an early-exiting grep under pipefail — use a here-string (see the checker's message)"; fail=1
    fi
  fi
fi

# ── Prettier on staged SHIPPED files (mirrors CI «Shipped artifacts are Prettier-clean») ──
#   Change-scoped: scripts/format-shipped.sh intersects the staged list with the shipped
#   surface (same enumeration + same pinned prettier as the CI gate), so commits that do
#   not touch shipped files never invoke prettier. GH #531 dogfood, moved to the earliest
#   reachable channel (commit-time) — was CI-only, ~18 red runs in July 2026.
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if [ -n "$STAGED_ALL" ] && command -v npx &>/dev/null; then
  # shellcheck disable=SC2086
  bash "$REPO_ROOT/scripts/format-shipped.sh" --check $STAGED_ALL \
    || { echo "❌ staged shipped files are not Prettier-clean — fix: npm run format (= scripts/format-shipped.sh --write)"; fail=1; }
fi

# ── CANON symlink guard — orchestrator-prompts staged as mode 120000 ────────
# spec: .claude/rules/kickoff-staging-placement.md §5 (#canon-symlink-swallows-commit)
#
# `.claude/orchestrator-prompts/**` is gitignored with per-umbrella `!` exceptions, and
# scripts/link-coordination.sh adopts every UNTRACKED file there into $CANON, leaving a
# symlink behind. Write a new kickoff, `git add` it in a LATER step, and the index takes
# the 84-byte CANON path as a mode-120000 blob instead of the content. Measured 2026-09-02:
# commit 9e046c6d55 carried `120000 blob 2d02772193b2b6c1ba2301edf3cc00a3e2902640` while the
# 232-line kickoff lived only in $CANON. NOTHING surfaced it — `git status` shows a normal
# path, `wc -l` reads through the link, markdownlint passed, the soft spec-validate below
# passed. The damage is deferred: the commit is worthless as a copy, so a later $CANON
# cleanup destroys the only one. Zero tracked symlinks exist repo-wide → no allowlist needed.
#
# ERROR, not warning: the failure is silent and the correct action is unambiguous
# (.claude/rules/attention-is-not-a-mechanism.md §1 rejects load-bearing warnings — a warning
# here would have exactly one consumer, «somebody reads the pre-commit log»).
# Pre-commit is the EARLIEST reachable channel: edit-time cannot see a symlink that does not
# exist yet. Principle 44 arm A is the durable backstop for commits husky never runs
# (aif-container work). `--raw` reports the DESTINATION mode in field 2; the path is
# tab-separated (last field, so a rename's new path wins and spaces survive).
STAGED_LINKS=$(git diff --cached --raw --diff-filter=ACMR -- .claude/orchestrator-prompts 2>/dev/null \
  | awk -F'\t' '{ split($1, m, " "); if (m[2] == "120000") print $NF }' || true)
if [ -n "$STAGED_LINKS" ]; then
  echo "❌ SYMLINK staged under .claude/orchestrator-prompts — the \$CANON path would be committed, not the content:"
  echo "$STAGED_LINKS" | sed 's/^/   /'
  echo "   The file was adopted into \$CANON (~/.claude-coordination/...) because it was still UNTRACKED"
  echo "   when scripts/link-coordination.sh ran. Committing this loses the real content."
  echo "   Fix: restore the real content, then write + \`git add\` in ONE step:"
  echo "     cp \"\$(readlink <path>)\" /tmp/k.md && rm <path> && mv /tmp/k.md <path> && git add <path>"
  fail=1
fi

# ── Spec discipline (Phase 1.C) — soft warn for staged orchestrator-prompts ──
SPEC_FILES=$(echo "$CHANGED" | grep '^\.claude/orchestrator-prompts/.*\.md$' || true)
if [ -n "$SPEC_FILES" ]; then
  echo "ℹ Validating staged orchestrator-prompts (soft-warn)..."
  # shellcheck disable=SC2086
  npx tsx "$REPO_ROOT/packages/core/spec-validation/validate-batch-spec.ts" --soft $SPEC_FILES \
    || echo "⚠ spec-validate findings; pre-push will hard-fail"
fi

# ── Guard-liveness: structural check — ESLint rules need negative-test.input ─
# Change-scoped: fires only when rules-manifest.json is staged.
# Liveness (actually runs ESLint) is deferred to pre-push (guard-liveness gate).
MANIFEST_STAGED=$(echo "$CHANGED" | grep 'packages/core/manifest/rules-manifest.json' || true)
if [ -n "$MANIFEST_STAGED" ] && command -v node &>/dev/null; then
  node -e '
const d = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
const bad = [];
for (const [id, r] of Object.entries(d)) {
  if (r.check.type !== "eslint") continue;
  const nt = r["negative-test"];
  if (!nt || !Array.isArray(nt.input) || nt.input.length === 0) bad.push(id);
}
if (bad.length) {
  console.error("❌ ESLint rules missing negative-test.input: " + bad.join(", "));
  console.error("  Add a negative-test block with at least one bypass input.");
  process.exit(1);
}
' "$REPO_ROOT/packages/core/manifest/rules-manifest.json" || { fail=1; }
fi

# ── Cmd/script liveness: structural check — command/script rules need fixture ─
# Change-scoped: fires only when rules-manifest.json is staged.
# Liveness (actually running the check) is deferred to pre-push (cmd-script-liveness gate).
# Fixture is required ONLY for the modes that execute it — run-and-assert
# (command, or liveness-mode="run") and resolve-and-run (script). The non-executing
# modes (workflow-exists / config-presence / exempt) are excluded, so a required
# setup-script there is not inert dead data.
if [ -n "$MANIFEST_STAGED" ] && command -v node &>/dev/null; then
  node -e '
const d = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
const MIN = 5;
const FIXTURE_OPTIONAL = new Set(["workflow-exists", "config-presence", "exempt"]);
const bad = [];
for (const [id, r] of Object.entries(d)) {
  if (r.check.type !== "command" && r.check.type !== "script") continue;
  if (FIXTURE_OPTIONAL.has(r["liveness-mode"])) continue;
  const fx = r.fixture;
  const setup = fx && fx["setup-script"];
  if (!setup || setup.trim().length < MIN) bad.push(id);
}
if (bad.length) {
  console.error("❌ command/script run/resolve rules missing fixture.setup-script: " + bad.join(", "));
  console.error("  Add a fixture.setup-script embodying the violation, or set a non-executing liveness-mode (workflow-exists/config-presence/exempt).");
  process.exit(1);
}
' "$REPO_ROOT/packages/core/manifest/rules-manifest.json" || { fail=1; }
fi


# ── Invariants-line render (2026-09-28) ───────────────────────────────
# The session digest's INVARIANTS_LINE is rendered from README.md «What must not break
# (invariants)» by scripts/render-invariants.mjs. When README.md or the hook is staged:
#   - both files match the index (no unstaged edits): re-render and stage the hook, so
#     nobody has to remember `--write` (the plugin has shipped no twin of this hook since
#     2026-09-29 — the framework digest is not a consumer's context);
#   - otherwise (unstaged edits, `git add -p`): auto-staging would sweep unstaged work into
#     the commit, and the working tree is not what gets committed — so check the STAGED pair
#     (index README.md against index hook, in a temp root) and fail on drift.
# Here-strings, not `echo "$CHANGED" | grep -q`: under pipefail the early-exiting grep can
# SIGPIPE echo on a large $CHANGED, and the test then reads false and skips the block.
INV_HOOK=".claude/hooks/inject-session-bootstrap.sh"
INV_RENDER="$REPO_ROOT/scripts/render-invariants.mjs"
if [ -f "$INV_RENDER" ] && { grep -qx 'README.md' <<<"$CHANGED" || grep -qxF "$INV_HOOK" <<<"$CHANGED"; }; then
  if ! command -v node >/dev/null 2>&1; then
    echo "⚠ node not found — invariants-line render skipped (pre-push and CI still check it)"
  elif git diff --quiet -- README.md "$INV_HOOK"; then
    if node "$INV_RENDER" --write >/dev/null; then
      if ! git diff --quiet -- "$INV_HOOK"; then
        git add "$INV_HOOK"
        CHANGED=$(printf '%s\n%s' "$CHANGED" "$INV_HOOK")
        echo "✓ invariants line re-rendered from README.md and staged ($INV_HOOK)"
      fi
    else
      fail=1
    fi
  else
    inv_tmp=$(mktemp -d)
    mkdir -p "$inv_tmp/.claude/hooks"
    if git show ":README.md" >"$inv_tmp/README.md" && git show ":$INV_HOOK" >"$inv_tmp/$INV_HOOK"; then
      if ! node "$INV_RENDER" --check --root "$inv_tmp"; then
        echo "  (checked the STAGED README.md + $INV_HOOK; run node scripts/render-invariants.mjs --write and stage both)"
        fail=1
      fi
    else
      echo "❌ could not read the staged README.md / $INV_HOOK for the invariants-line check"
      fail=1
    fi
    rm -rf "$inv_tmp"
  fi
fi

# ── Plugin twin regeneration ──────────────────────────────────────────
# When .claude/hooks/*.sh or agents/*.md changes, regenerate plugin twins and re-stage.
# Spec: .ai-factory/plans/zcode-parity-s6-twin-generator.md (Stage 6).
#
# The agents/ arm was added 2026-08-17: plugin/agents/*.md twins were guarded only AFTER
# the fact by principle 24(d) (byte-identity, CI) while plugin/hooks/ regenerated here
# automatically — so every agents/*.md edit went CI-red until someone remembered a manual
# copy. PR #1430 hit exactly that. Detection was never the gap; regeneration was.
HOOKS_STAGED=$(echo "$CHANGED" | grep '^\.claude/hooks/.*\.sh$' || true)
AGENTS_STAGED=$(echo "$CHANGED" | grep '^agents/.*\.md$' || true)
if [ -n "$HOOKS_STAGED" ] || [ -n "$AGENTS_STAGED" ]; then
  if bash "$REPO_ROOT/scripts/generate-plugin-twins.sh"; then
    # Re-stage both twin dirs regardless of which source fired: the generator is a single
    # idempotent pass over both populations, and staging a dir it did not touch is a no-op.
    # Narrowing to the fired arm would drop a twin when one commit edits a hook AND an agent.
    git add plugin/hooks/ 2>/dev/null || true
    git add plugin/agents/ 2>/dev/null || true
  else
    echo "❌ generate-plugin-twins.sh failed"
    fail=1
  fi
fi

# ── Plugin skills regeneration (plugin-skills-generator Stage 1, 2026-09-11) ──────
# When a source population of a table-managed plugin/skills entry changes (top-level
# skills/ or .claude/skills/), regenerate the derived copies and re-stage. The generator
# self-no-ops for in-sync entries and refuses (exit 3) on un-derivable payload content,
# so firing on the whole populations is safe and stays future-proof when Stage 2 adds
# the CORE four to the entry table.
# Patch: docs/meta-factory/research-patches/2026-09-11-plugin-skills-generator-stage0-reverif.md
SKILLS_STAGED=$(echo "$CHANGED" | grep -E '^(skills/|\.claude/skills/)' || true)
if [ -n "$SKILLS_STAGED" ]; then
  if bash "$REPO_ROOT/scripts/generate-plugin-skills.sh"; then
    git add plugin/skills/ 2>/dev/null || true
  else
    echo "❌ generate-plugin-skills.sh failed"
    fail=1
  fi
fi


# ── Unpushed-merge refusal — the CONFLICTED-merge channel ───────────────────
# spec: scripts/check-merge-pushed.sh header; test: tests/hooks/merge-unpushed-refusal.test.sh.
# A clean `git merge` is checked by .husky/pre-merge-commit. A conflicted one (or
# `merge --no-commit`) never runs that hook: its resolution is committed by `git commit`,
# which lands here with MERGE_HEAD present. The empty-diff early exit at the top of this
# file lets a merge through to this arm. Placed LAST so no section above shifts: their
# line numbers are cited from docs and scripts.
# The script is resolved next to this hook, not under REPO_ROOT, so a worktree on a branch
# that predates it still gets the check the hook ships with.
MP_CHECK="$(cd "$(dirname "$0")" && pwd)/../scripts/check-merge-pushed.sh"
if [ -f "$MP_CHECK" ] && git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  bash "$MP_CHECK" pre-commit || exit 1
fi

exit "$fail"
