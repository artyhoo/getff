#!/usr/bin/env bash
# Pre-commit hook: fast checks only (target: <5 seconds).
# Author-side enforcement for rules-as-tests-aif repo.
# Installs via: make install-hooks
#
# Probes (Decision matrix MUST rows, self-application.md §3):
#   - Bash syntax:      bash -n on changed *.sh
#   - JSON validity:    python3 json.load on changed *.json
#   - YAML validity:    python3 yaml.safe_load on changed *.yml/*.yaml
#   - Markdown ≤500 lines: awk on changed *.md
#   - markdownlint-cli2:   structural rules on staged *.md (sub-wave 7.1.a)
#   - guard-liveness:  ESLint rules in rules-manifest.json have negative-test.input

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
CHANGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$CHANGED" ]; then
  exit 0
fi

fail=0

while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in
    *.sh)
      if ! bash -n "$f" 2>/tmp/pre-commit-err; then
        echo "❌ Bash syntax error in $f:"
        cat /tmp/pre-commit-err
        fail=1
      fi
      ;;
    *.json)
      if ! python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f" 2>/tmp/pre-commit-err; then
        echo "❌ Invalid JSON in $f:"
        cat /tmp/pre-commit-err
        fail=1
      fi
      ;;
    *.yml|*.yaml)
      if ! python3 -c "import yaml,sys; yaml.safe_load(open(sys.argv[1]))" "$f" 2>/tmp/pre-commit-err; then
        echo "❌ Invalid YAML in $f:"
        cat /tmp/pre-commit-err
        fail=1
      fi
      ;;
    *.md)
      # Exempt: declared-transient artifacts (must contain "transient artifact" in first 20 lines)
      # (2026-08-08: no CI mirror — audit-self.yml carries no 600-line check; this hook is the only channel.)
      case "$f" in
        docs/meta-factory/EXECUTION-PLAN.md)
          if head -20 "$f" | grep -qi "transient artifact"; then
            : # skip — declared transient, see line 8
          else
            echo "❌ $f is in exempt list but lacks 'transient artifact' marker in first 20 lines"
            fail=1
          fi
          continue
          ;;
        # Grandfathered over-limit closed research-patch (605 lines at closure, 2026-05-29).
        # Append-only archive: splitting would sever its folder-level authority + external
        # citations, so it is exempted instead (operator decision 2026-08-08, PR #1282 fork).
        # The marker requirement keeps the exemption self-documenting at the file itself.
        docs/meta-factory/research-patches/2026-05-29-aif-handoff-bridge-variant-b-prime-hybrid.md)
          if head -20 "$f" | grep -qi "line-limit-exempt"; then
            : # skip — grandfathered, see marker in file header
          else
            echo "❌ $f is in exempt list but lacks 'line-limit-exempt' marker in first 20 lines"
            fail=1
          fi
          continue
          ;;
        # Oversized closed meta-kickoffs (730/664 lines at the 2026-08-21 host-verify
        # retrofit). Both had ALREADY self-declared the 'transient artifact' exemption in
        # their headers (SSOT #116 note, line 3) — only this case entry was missing, so the
        # gate would have blocked the first-ever edit since it landed. Append-only history:
        # same list∩marker shape as the two entries above.
        .claude/orchestrator-prompts/queue-mode-bootstrap/kickoff.md|\
.claude/orchestrator-prompts/strategic-clarity-dialogue/kickoff.md)
          if head -20 "$f" | grep -qi "transient artifact"; then
            : # skip — declared transient in file header (pre-existing)
          else
            echo "❌ $f is in exempt list but lacks 'transient artifact' marker in first 20 lines"
            fail=1
          fi
          continue
          ;;
      esac
      lines=$(awk 'END{print NR}' "$f")
      if [ "$lines" -gt 600 ]; then
        echo "❌ Markdown file $f exceeds 600 lines ($lines lines). Split or trim."
        fail=1
      fi
      ;;
  esac
done <<< "$CHANGED"

# ── markdownlint-cli2 on staged *.md (structural rules) ─────────────────────
#   Runs after the per-file loop so line-count failures are already recorded.
#   Uses ACMR diff-filter (includes renames) to catch moved docs with violations.
#   History: the orchestrator-prompts corpus was briefly excluded on legacy
#   touches (2026-08-21 host-verify retrofit, A/M split) with a re-entry
#   trigger; the trigger FIRED the same day (PR: legacy lint+link repair —
#   401 violations repaired to zero across 956 on-disk md files) and the filter was
#   dropped. The whole corpus lints again.
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '\.md$' || true)
if [ -n "$STAGED_MD" ]; then
  if command -v npx &>/dev/null; then
    # shellcheck disable=SC2086
    npx markdownlint-cli2 $STAGED_MD \
      || { echo "❌ markdownlint-cli2 violations — fix before commit"; fail=1; }
  fi
fi

# ── Prettier on staged SHIPPED files (mirrors CI «Shipped artifacts are Prettier-clean») ──
#   Change-scoped: scripts/format-shipped.sh intersects the staged list with the shipped
#   surface (same enumeration + same pinned prettier as the CI gate), so commits that do
#   not touch shipped files never invoke prettier. GH #531 dogfood, moved to the earliest
#   reachable channel (commit-time) — was CI-only, ~18 red runs in July 2026.
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if [ -n "$STAGED_ALL" ] && command -v npx &>/dev/null; then
  # shellcheck disable=SC2086
  bash "$REPO_ROOT/scripts/format-shipped.sh" --check $STAGED_ALL \
    || { echo "❌ staged shipped files are not Prettier-clean — fix: npm run format (= scripts/format-shipped.sh --write)"; fail=1; }
fi

# ── Spec discipline (Phase 1.C) — soft warn for staged orchestrator-prompts ──
SPEC_FILES=$(echo "$CHANGED" | grep '^\.claude/orchestrator-prompts/.*\.md$' || true)
if [ -n "$SPEC_FILES" ]; then
  echo "ℹ Validating staged orchestrator-prompts (soft-warn)..."
  # shellcheck disable=SC2086
  npx tsx "$REPO_ROOT/packages/core/spec-validation/validate-batch-spec.ts" --soft $SPEC_FILES \
    || echo "⚠ spec-validate findings; pre-push will hard-fail"
fi

# ── Guard-liveness: structural check — ESLint rules need negative-test.input ─
# Change-scoped: fires only when rules-manifest.json is staged.
# Liveness (actually runs ESLint) is deferred to pre-push (guard-liveness gate).
MANIFEST_STAGED=$(echo "$CHANGED" | grep 'packages/core/manifest/rules-manifest.json' || true)
if [ -n "$MANIFEST_STAGED" ] && command -v node &>/dev/null; then
  node -e '
const d = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
const bad = [];
for (const [id, r] of Object.entries(d)) {
  if (r.check.type !== "eslint") continue;
  const nt = r["negative-test"];
  if (!nt || !Array.isArray(nt.input) || nt.input.length === 0) bad.push(id);
}
if (bad.length) {
  console.error("❌ ESLint rules missing negative-test.input: " + bad.join(", "));
  console.error("  Add a negative-test block with at least one bypass input.");
  process.exit(1);
}
' "$REPO_ROOT/packages/core/manifest/rules-manifest.json" || { fail=1; }
fi

# ── Cmd/script liveness: structural check — command/script rules need fixture ─
# Change-scoped: fires only when rules-manifest.json is staged.
# Liveness (actually running the check) is deferred to pre-push (cmd-script-liveness gate).
# Fixture is required ONLY for the modes that execute it — run-and-assert
# (command, or liveness-mode="run") and resolve-and-run (script). The non-executing
# modes (workflow-exists / config-presence / exempt) are excluded, so a required
# setup-script there is not inert dead data.
if [ -n "$MANIFEST_STAGED" ] && command -v node &>/dev/null; then
  node -e '
const d = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
const MIN = 5;
const FIXTURE_OPTIONAL = new Set(["workflow-exists", "config-presence", "exempt"]);
const bad = [];
for (const [id, r] of Object.entries(d)) {
  if (r.check.type !== "command" && r.check.type !== "script") continue;
  if (FIXTURE_OPTIONAL.has(r["liveness-mode"])) continue;
  const fx = r.fixture;
  const setup = fx && fx["setup-script"];
  if (!setup || setup.trim().length < MIN) bad.push(id);
}
if (bad.length) {
  console.error("❌ command/script run/resolve rules missing fixture.setup-script: " + bad.join(", "));
  console.error("  Add a fixture.setup-script embodying the violation, or set a non-executing liveness-mode (workflow-exists/config-presence/exempt).");
  process.exit(1);
}
' "$REPO_ROOT/packages/core/manifest/rules-manifest.json" || { fail=1; }
fi


# ── Plugin twin regeneration ──────────────────────────────────────────
# When .claude/hooks/*.sh or agents/*.md changes, regenerate plugin twins and re-stage.
# Spec: .ai-factory/plans/zcode-parity-s6-twin-generator.md (Stage 6).
#
# The agents/ arm was added 2026-08-17: plugin/agents/*.md twins were guarded only AFTER
# the fact by principle 24(d) (byte-identity, CI) while plugin/hooks/ regenerated here
# automatically — so every agents/*.md edit went CI-red until someone remembered a manual
# copy. PR #1430 hit exactly that. Detection was never the gap; regeneration was.
HOOKS_STAGED=$(echo "$CHANGED" | grep '^\.claude/hooks/.*\.sh$' || true)
AGENTS_STAGED=$(echo "$CHANGED" | grep '^agents/.*\.md$' || true)
if [ -n "$HOOKS_STAGED" ] || [ -n "$AGENTS_STAGED" ]; then
  if bash "$REPO_ROOT/scripts/generate-plugin-twins.sh"; then
    # Re-stage both twin dirs regardless of which source fired: the generator is a single
    # idempotent pass over both populations, and staging a dir it did not touch is a no-op.
    # Narrowing to the fired arm would drop a twin when one commit edits a hook AND an agent.
    git add plugin/hooks/ 2>/dev/null || true
    git add plugin/agents/ 2>/dev/null || true
  else
    echo "❌ generate-plugin-twins.sh failed"
    fail=1
  fi
fi

exit "$fail"
