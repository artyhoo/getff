{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "getff reference family B (skills)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "familyName",
    "generator",
    "members"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "family": {
      "const": "B"
    },
    "familyName": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "const": "scripts/render-reference.mjs"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "shipsTo",
          "description",
          "source",
          "extras",
          "example"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "skill"
          },
          "shipsTo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tier"
            ],
            "properties": {
              "tier": {
                "enum": [
                  "core",
                  "env",
                  "factory",
                  "framework"
                ]
              },
              "stacks": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "absent": {
                "enum": [
                  "no-lane",
                  "no-operator-twin",
                  "not-byte-copied"
                ]
              }
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "extras": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invocation",
              "posture",
              "operator-twin"
            ],
            "properties": {
              "invocation": {
                "enum": [
                  "auto",
                  "slash-only"
                ]
              },
              "posture": {
                "type": "string",
                "minLength": 1
              },
              "operator-twin": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "absent"
                    ],
                    "properties": {
                      "absent": {
                        "enum": [
                          "no-lane",
                          "no-operator-twin",
                          "not-byte-copied"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          "example": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}
