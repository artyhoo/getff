{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "getff reference family A (installer layers)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "familyName",
    "generator",
    "members"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "family": {
      "const": "A"
    },
    "familyName": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "const": "scripts/render-reference.mjs"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "shipsTo",
          "description",
          "source",
          "extras",
          "example"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "installer-layer"
          },
          "shipsTo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tier"
            ],
            "properties": {
              "tier": {
                "const": "all"
              }
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "extras": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order"
            ],
            "properties": {
              "order": {
                "type": "integer"
              }
            }
          },
          "example": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}
