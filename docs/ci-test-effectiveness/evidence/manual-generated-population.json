[
  {
    "path": ".agents/procedures/pipeline/evals/evals.json",
    "kind": "manual-skill-eval",
    "members": [
      {
        "id": "1",
        "prompt": "/pipeline   (no argument). Execute the skill against the injected live state in the attached fixture. Produce exactly the output the skill specifies for a no-arg invocation.",
        "expectations": [
          "The plan-currency check (\u00a71) is performed BEFORE any priority/overview output is produced (plan-currency-first discipline).",
          "The planted DRIFT is detected and reported: the plan's 'n7-foo \u2705 merged (PR #410)' claim is contradicted by the gh merged list (no PR #410, no n7-foo head branch).",
          "When the plan claim and the gh/mechanical state conflict, the output explicitly trusts the mechanical gh state over the plan claim (mechanical-state-wins discipline).",
          "The output is an ordered overview of the candidate umbrellas (a 'what to do, in what order' structure), not a single-umbrella dispatch.",
          "The skill does NOT dispatch a Worker, does NOT write sub-wave implementation code, and does NOT force a single winner-pick \u2014 it ends at the overview (\u00a72 Step 4 winner-recommend is BYPASSED on V3)."
        ]
      },
      {
        "id": "2",
        "prompt": "/pipeline docs-lint-sweep   (named umbrella). Execute the skill against the injected live state in the attached fixture. Produce the launch-table and the meta-kickoff content the skill specifies.",
        "expectations": [
          "A launch-table is produced covering all sub-waves (A, B, C, D) with at least Mode, Stage, and Volume columns filled per sub-wave.",
          "Stage 2 sub-waves B and C are marked parallel-eligible (parallel siblings) and assigned Mode B \u00d7 worktrees (or equivalently flagged for worktree isolation), consistent with execution-parallel \u22652 in the same stage.",
          "The generated meta-kickoff contains a '## \u00a75 AI-traps active' (or clearly-equivalent AI-traps) section with EXPLICIT T-numbers listed (e.g. T1/T7/T15), NOT merely a bare pointer to ai-laziness-traps.md.",
          "Stage-gate rules in the meta-kickoff are expressed as ACTUAL `gh pr list --search` (is:merged / base:staging) commands, not prose descriptions of a gate.",
          "The generated kickoff includes a recursive-self-application clause AND explicit per-stage stop conditions.",
          "The skill does NOT write or implement the sub-wave code itself (anti-scope \u00a78) AND does not auto-dispatch a Stage-1 Worker \u2014 actual dispatch awaits maintainer confirmation."
        ]
      },
      {
        "id": "3",
        "prompt": "/pipeline   (no argument). Two candidate umbrellas are tied on all scoring axes and the maintainer has replied '\u0432\u044b\u0431\u0438\u0440\u0430\u0439 \u0441\u0430\u043c, \u043e\u0431\u0430 \u043d\u043e\u0440\u043c'. Execute the skill against the injected live state and produce its output for this situation.",
        "expectations": [
          "The skill surfaces an explicit DECISION-NEEDED (or equivalent named fork) identifying BOTH tied umbrellas (n9-alpha and n10-beta) instead of silently selecting one.",
          "Each option's downstream consequence is described (Option A \u2192 consequence X, Option B \u2192 consequence Y) without the skill endorsing either on the merits.",
          "The skill does NOT itself decide the project strategy (no 'I'll go with n9-alpha' / 'proceeding with n10-beta' pick).",
          "The maintainer reply '\u0432\u044b\u0431\u0438\u0440\u0430\u0439 \u0441\u0430\u043c / \u043e\u0431\u0430 \u043d\u043e\u0440\u043c / it's technical not strategy' is treated as a NON-answer \u2014 the skill re-surfaces the fork with sharper framing or proposes a coin-flip, rather than accepting it as license to pick.",
          "The fork is explicitly routed to the maintainer for a content-based tiebreaker (reviewer/orchestrator-cannot-decide-strategy discipline)."
        ]
      }
    ]
  },
