  "format": "gzip contains exact original UTF-8 JSON/text bytes; gzip -dc PATH restores logical capture. SHA256 records both representations. JSONL case inventory has explicit member identities/criterion applicability.",
  "reproduction": {
    "source": "git archive auditedHead to disposable directory; git init + git add to provide tracked-name population without touching baseline; use provisioned deps as read-only links",
    "vitest": "From each package cwd: node ../../node_modules/vitest/vitest.mjs list --json=<scratch output>. Core/bridge/next/SPA/RN configs and source hashes are in baseline. Collection can run module initialization; use watchdog.",
    "node": "Exact argv in node-discovery.json. Node filtered file-level TAP is not case enumeration. AST captures declarations including aliases; external-corpus validator requires its documented argument.",
    "python": "PYTHONDONTWRITEBYTECODE=1 python3 evidence/capture/python-discover.py (adapt workspace constants to disposable root); unittest load only, not run.",
    "shell": "git-tracked source population plus complete declaration/oracle expressions; no fabricated shell runtime-case total.",
    "workflows": "PyYAML BaseLoader over tracked workflow definitions; exact steps, events, strategy preserved. Real local sweep --list-gates does not execute gates.",
    "github": "gh run list --repo artyhoo/getff --limit60 --json databaseId,workflowName,event,status,conclusion,createdAt,startedAt,updatedAt,headSha,url; gh api repos/artyhoo/getff/actions/runs/ID/jobs --paginate; gh api repos/artyhoo/getff/branches/staging; gh pr view2144 and paginated files. Job logs fetched through GitHub connector after gh redirect failures.",
    "probes": "probe-ledger.json gives fixed oracle, commands, hashes and classifications; perform only in disposable copy. No full recurring suite is prerequisite.",
    "reviewCorrection": "After initial capture/compaction, evidence/capture/reconcile-review-1.py performs the frozen source correction; original generators consume the reviewed delivery/assessment records. It is a one-shot audit materialization, not a new permanent parser or recurring detector. evidence/capture/validate-review-1.py checks bounded correction consistency and preserved original bytes against review base8c13d593."
  },
  "storageDecision": "Compress immutable-source/API/runner duplicates and long captures, retain readable inventory/decisions/family reports. The one-shot capture scripts are not validators or recurring machinery. No new CI cost is imposed by the audit itself beyond normal repository file scans.",
