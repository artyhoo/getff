  "change_policy": "any post-freeze change requires a batch note in docs/test-assurance-kernel/s1/batches.md saying why, and an independent-freeze receipt in s1/cold-review.md",
  "rules": {
    "no-vacuous-assertion": {
      "plugin": "rules-as-tests",
      "messageId": "vacuousAssertion",
      "q": "Q1",
      "declared_scope": "static, decidable syntax only: expect(<literal-only pure expression>).<matcher...> inside a test body; // audit:exempt line exclusion; NO dataflow claims"
    },
    "require-effective-assertion": {
      "plugin": "rules-as-tests",
      "messageId": "noEffectiveAssertion",
      "q": "Q2",
      "declared_scope": "static, decidable syntax only: it/test callback bodies must contain an effective-assertion call (expect*/assert*/verify*-named); skipped/todo/fails variants exempt; // audit:exempt line exclusion; NO claim that a recognized name asserts substantively"
    }
  },
  "channel_map": {
    "Q1": "static-eslint (no-vacuous-assertion); fabricated-status sibling also evidenced by executed conformance",
    "Q2": "static-eslint (require-effective-assertion)",
    "Q3": "counterfactual-audit over pinned reached faults (Batch D) — static rules make NO claim (no AST dataflow)",
    "Q4": "executed-conformance against real subprocess outcomes (Batch C)",
    "Q5": "executed-conformance through the real structural gate (Batch C)",
    "Q6": "delivery-conformance through the real emitted artifact (Batch E)",
    "wrong-import": "review-channel-only: named cold-review protocol + blocking dispositions queue — honest limit, no gate claim"
  },
