{
  "*.{ts,tsx}": [
    "bash scripts/run-armed.sh --if-armed 'npm run format:check' prettier --write",
    "bash scripts/run-armed.sh --if-armed 'npm run lint' eslint --fix --max-warnings=0 --no-warn-ignored"
  ],
  "*.{js,mjs,cjs,jsx}": [
    "bash scripts/run-armed.sh --if-armed 'npm run format:check' prettier --write",
    "bash scripts/run-armed.sh --if-armed 'npm run lint' eslint --fix --max-warnings=0 --no-warn-ignored"
  ],
  "*.{json,md,yml,yaml}": [
    "bash scripts/run-armed.sh --if-armed 'npm run format:check' prettier --write"
  ],
  "package.json": ["sort-package-json"]
}
