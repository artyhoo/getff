# getff pre-push entry — runs the getff python pre-push rung through the pre-commit framework's
# pre-push stage, which the installer installs with pre-commit's own command.
#
# Delivered by setup.d/45-python.sh, which keeps this entry current on --refresh while it is
# unedited (an edited entry is kept as it is); the script body lives at .getff/hooks/pre-push.
# Remove this entry (or run with `SKIP=getff-python-pre-push ...`) to disable it.
- repo: local
  hooks:
    - id: getff-python-pre-push
      name: getff Python pre-push (ast-grep + ruff)
      entry: .getff/hooks/pre-push
      language: system
      stages: [pre-push]
      pass_filenames: false
