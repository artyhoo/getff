{
  "name": "@rules-as-tests/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework core for rules-as-tests — discipline-bearing code as the project's contract artifact. Ships the rule manifest, ESLint rules, detector/research/synthesizer/installer toolchain, templates, skills, and install wiring.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "main": "./manifest/rules-manifest.json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yhooi2/rules-as-tests-aif.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Yhooi2/rules-as-tests-aif/tree/staging/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Yhooi2/rules-as-tests-aif/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "manifest/",
    "eslint-rules/",
    "detector/",
    "research/",
    "synthesizer/",
    "installer/",
    "validator/",
    "ir/",
    "backends/",
    "diagnostics/",
    "composition/",
    "templates/",
    "install/",
    "skills/"
  ],
  "bin": {
    "rules-as-tests-detect": "./detector/cli.ts",
    "rules-as-tests-research": "./research/cli.ts",
    "rules-as-tests-synth": "./synthesizer/cli.ts",
    "rules-as-tests-validate": "./validator/cli.ts",
    "rules-as-tests-install": "./installer/cli.ts",
    "rules-as-tests-verify-provenance": "./synthesizer/verify-provenance-cli.ts"
  },
  "exports": {
    "./manifest": "./manifest/rules-manifest.json",
    "./manifest-schema": "./manifest/rules-manifest.schema.json",
    "./eslint-rules": "./eslint-rules/index.ts",
    "./detector": "./detector/index.ts",
    "./research": "./research/index.ts",
    "./synthesizer": "./synthesizer/index.ts",
    "./installer": "./installer/index.ts"
  },
  "scripts": {
    "test": "vitest run --reporter=default",
    "test:principles": "vitest run principles/",
    "test:hooks": "vitest run hooks/",
    "test:ir": "vitest run ir/",
    "test:backends": "vitest run backends/",
    "test:composition": "vitest run composition/",
    "test:render": "vitest run render/",
    "test:live-generation": "vitest run synthesizer/research-to-node.test.ts synthesizer/research-to-clippy-node.test.ts synthesizer/live-generation-clippy.test.ts",
    "test:template-render": "vitest run audit-self/template-render.audit.ts",
    "test:synthesizer": "vitest run synthesizer/",
    "test:skills": "vitest run skills/",
    "test:spec-validation": "vitest run spec-validation/",
    "test:units": "vitest run audit-self/ detector/ detector-v0/ diagnostics/ diff/ eslint-rules/ install/ installer/ python-starter/ research/ scenario-generator/ validator/",
    "guard-liveness:fullsweep": "tsx hooks/checks/guard-liveness-fullsweep.ts",
    "demo:cargo": "bash backends/cargo/demo/run-demo.sh",
    "typecheck": "tsc --noEmit",
    "render-rules": "tsx render/render-rules.ts",
    "render-rules:check": "tsx render/render-rules.ts --check",
    "render:python": "tsx python-starter/render-python-templates.ts",
    "render:python:check": "tsx python-starter/render-python-templates.ts --check",
    "render:researched": "tsx synthesizer/render-researched-astgrep.ts",
    "render:researched:check": "tsx synthesizer/render-researched-astgrep.ts --check",
    "render:researched:rust": "tsx synthesizer/render-researched-clippy.ts",
    "render:researched:rust:check": "tsx synthesizer/render-researched-clippy.ts --check",
    "detect": "tsx detector/cli.ts",
    "detect:install-rules": "tsx detector-v0/detect-applicable-rules.ts",
    "research": "tsx research/cli.ts",
    "synth": "tsx synthesizer/cli.ts",
    "verify:provenance": "tsx synthesizer/verify-provenance-cli.ts",
    "validate": "tsx validator/cli.ts",
    "install:synth": "tsx installer/cli.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@typescript-eslint/rule-tester": "^8.61.0",
    "@typescript-eslint/utils": "^8.61.0",
    "eslint": "^10.4.0",
    "js-yaml": "4.3.1",
    "picomatch": "^4.0.4",
    "ts-morph": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "semver": "7.8.5",
    "tsx": "^4.22.4"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
