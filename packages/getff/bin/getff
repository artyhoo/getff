#!/usr/bin/env node
// getff — the CLI entry of the `getff` npm distribution package.
//
//   npx getff init [<stack>] [-y] [--global] [--profile core|env|factory] [--dry-run] ...
//
// `init` hands every argument to the shipped `setup` orchestrator (README:10 — «getff init
// (via ./setup)»), which runs install.sh from THIS package's root. The tarball lays its
// contents out exactly as the repository root does (docs/meta-factory/
// getff-name-architecture-freeze.md §2 §0.5), so `install.sh`'s PKG_ROOT resolves to the
// installed package and none of its relative reads change. No network fetch happens here —
// a clone-at-runtime shim was rejected in the same record (unpinned, offline-hostile).
//
// WHY NODE AND NOT BASH. This file is the only `bin` in the whole dependency tree with a
// bash shebang (62 bin entries in a fresh install: 55 node, 6 tsx, 1 bash — this one). npm
// generates the Windows `.cmd`/`.ps1` shim by copying the shebang's interpreter and looking
// it up on PATH; on a Windows machine with WSL, `bash` on PATH is
// C:\WINDOWS\system32\bash.exe — the WSL launcher, which cannot open a C:\-style path.
// Measured: `npx <bash-shebang-bin>` from PowerShell → `/bin/bash: C:\...: No such file or
// directory`, exit 127, while the same shim run from Git Bash exits 0. A node shebang has no
// such ambiguity — npm installed this package, so node is by construction present and it is
// the node that runs the shim. Node also resolves the main module through its symlink
// (node_modules/.bin/getff → ../getff/bin/getff), which is why the readlink loop this file
// used to carry is gone rather than translated.
'use strict';

const { spawnSync } = require('node:child_process');
const { existsSync } = require('node:fs');
const { dirname, join, resolve } = require('node:path');

const ROOT = resolve(dirname(__filename), '..');

function usage() {
  return `getff — AI DX for your codebase: conventions AI agents can't silently bypass.

Usage:
  getff init [<stack>] [-y|--yes] [--global] [--profile core|env|factory] [--dry-run] [--all]
  getff --version
  getff --help

  init     Install the enforcement layer into the current project (runs the shipped
           setup/install.sh from this package). <stack> = ts-server | react-next |
           react-spa | react-native | python; omitted = auto-detected from package.json.
           Run it from the project root. -y installs into the project only; add
           --global to also install machine-wide companions (user-scope Claude
           plugins and MCP servers, npm -g tools, the runtime-bridge).

Docs: https://getff.ai/docs/  ·  Issues: https://github.com/artyhoo/getff/issues
`;
}

function version() {
  return require(join(ROOT, 'package.json')).version;
}

/**
 * Locate a bash able to open Windows paths.
 *
 * The order is the one already proven in this repo by plugin/hooks/run-hook.cmd
 * (ADOPT from obra/superpowers, MIT — prior-art SSOT #150): the Git for Windows
 * installation is searched BEFORE PATH, because PATH is exactly where the WSL
 * launcher sits. Git for Windows puts only `cmd/` on PATH (git.exe, no bash.exe),
 * so `bash` on PATH is never the Git Bash one — deriving it from the located
 * `git` is what covers a non-default install directory.
 */
function findBash() {
  if (process.platform !== 'win32') return 'bash';

  const candidates = [];
  if (process.env.GETFF_BASH) candidates.push(process.env.GETFF_BASH);

  for (const base of [process.env.ProgramFiles, process.env['ProgramFiles(x86)']]) {
    if (base) candidates.push(join(base, 'Git', 'bin', 'bash.exe'));
  }

  // `where git` → <install>\cmd\git.exe; Git Bash is its ..\bin\bash.exe sibling.
  const where = spawnSync('where', ['git'], { encoding: 'utf8' });
  if (where.status === 0) {
    for (const line of String(where.stdout).split(/\r?\n/)) {
      const p = line.trim();
      if (p) candidates.push(resolve(dirname(p), '..', 'bin', 'bash.exe'));
    }
  }

  for (const c of candidates) {
    if (existsSync(c)) return c;
  }
  return null;
}

function runSetup(args) {
  const setup = join(ROOT, 'setup');
  if (!existsSync(setup)) {
    console.error(`getff: shipped setup not found at ${setup} — the package is incomplete`);
    return 1;
  }

  const bash = findBash();
  if (!bash) {
    console.error(
      'getff: no bash found. Install Git for Windows (https://git-scm.com/download/win),\n' +
        '       or point GETFF_BASH at a bash.exe that can open Windows paths.\n' +
        "       (The `bash` on PATH is WSL's launcher, which cannot read C:\-style paths.)",
    );
    return 1;
  }

  const r = spawnSync(bash, [setup, ...args], { stdio: 'inherit' });
  if (r.error) {
    console.error(`getff: could not run ${bash}: ${r.error.message}`);
    return 1;
  }
  return r.status === null ? 1 : r.status;
}

function main(argv) {
  const cmd = argv[0] ?? '';
  switch (cmd) {
    case 'init':
      return runSetup(argv.slice(1));
    case '-v':
    case '--version':
    case 'version':
      process.stdout.write(`${version()}\n`);
      return 0;
    case '-h':
    case '--help':
    case 'help':
    case '':
      process.stdout.write(usage());
      return 0;
    default:
      process.stderr.write(`getff: unknown command '${cmd}'\n\n`);
      process.stderr.write(usage());
      return 2;
  }
}

process.exitCode = main(process.argv.slice(2));
