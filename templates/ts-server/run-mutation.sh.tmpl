#!/usr/bin/env bash
# scripts/run-mutation.sh — AUTO-GENERATED by install.sh for a multi-stack monorepo (#931 PR-2).
#
# setup.d/40-configs.sh's multi-stack branch emits one Stryker config per qualifying workspace
# under stryker/<workspace-slug>.json (never a single root stryker.config.json — that ships only
# from the flat/single-root branch). This wrapper is the "test:mutation" runner for that shape:
# it runs Stryker once per config and aggregates a non-zero exit if ANY package's run fails.
#
# Stryker 9 invocation is POSITIONAL: `stryker run <configFile>`. `-c` means --concurrency in
# Stryker 9, NOT a config flag — never pass the config via -c.
#
# Usage: bash scripts/run-mutation.sh [--incremental] [any other stryker flags]
#   (forwarded verbatim to every per-package `stryker run` invocation)
set -euo pipefail
cd "$(dirname "$0")/.."

shopt -s nullglob
configs=(stryker/*.json)
shopt -u nullglob

if [ "${#configs[@]}" -eq 0 ]; then
  echo "No stryker/*.json configs found — nothing to mutate."
  exit 0
fi

rc=0
for cfg in "${configs[@]}"; do
  echo "▶ stryker run $cfg"
  stryker run "$cfg" "$@" || rc=1
done
exit "$rc"
